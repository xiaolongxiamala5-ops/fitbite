    },
    "requiredIngredients": [
      {
        "id": "v_broccoli",
        "name": "西兰花",
        "amount": 200,
        "unit": "g",
        "originalRawText": "西兰花 1 个",
        "mode": "single"
      }
    ],
    "pantryIngredients": [
      "pantry_garlic",
      "pantry_soy_sauce",
      "preset_oyster_sauce",
      "preset_sugar"
    ],
    "instructions": [
      "将 西兰花 切成小朵，清洗干净。",
      "将 大蒜 去皮，切成蒜末，备用。",
      "锅中加入 1000 ml 饮用水，大火烧开。",
      "放入 西兰花，保持大火 **煮 2-3 分钟**，至 西兰花 颜色变翠绿，口感变软。",
      "将 煮好的 西兰花 捞出，沥干水分，摆入盘中，备用。",
      "热锅，加入 10 ml 食用油。油温升高后，放入 大蒜末，小火煸炒出香味。",
      "加入 10 ml 生抽，5 ml 蚝油，2 g 白糖，加入 30 ml 饮用水。",
      "将锅中汤汁烧开。",
      "将烧好的蒜蓉汁 均匀淋在盘中的 西兰花 上。"
    ],
